{
  "name": "@artk0de/tree-sitter-swift",
  "version": "0.7.3-prebuild.1",
  "description": "tree-sitter-swift 0.7.3 (unpublished upstream) with N-API prebuilds.",
  "main": "bindings/node/index.js",
  "types": "bindings/node",
  "scripts": {
    "install": "node-gyp-build",
    "prebuildify": "prebuildify --napi --strip",
    "test": "node --test bindings/node/*_test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artk0de/tree-sitter-swift.git"
  },
  "tree-sitter": [
    {
      "scope": "source.swift",
      "file-types": [
        "swift"
      ],
      "injection-regex": "swift",
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "injections": "queries/injections.scm"
    }
  ],
  "keywords": [
    "parser",
    "swift"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "scripts/*",
    "src/**"
  ],
  "author": "Alex Pinkus <alex.pinkus@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/artk0de/tree-sitter-swift/issues"
  },
  "homepage": "https://github.com/artk0de/tree-sitter-swift/blob/prebuild/0.7.3/PREBUILD.md",
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "node-gyp-build": "^4.8.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.22.1 || ^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "node-gyp": "^10.0.1",
    "prebuildify": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
